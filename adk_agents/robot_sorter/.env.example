# Copy to .env (same folder) and fill in the key. .env is ignored by git: never commit it.
# Read by `adk web`, `adk run`, robot_sorter/serve.py and sim/modal_sim.py --action eval-adk.

# Your Gemini API key (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=PASTE_YOUR_KEY_HERE

# 0 = use the Gemini API with the key above (1 = Google Cloud / Vertex AI instead; then no key is needed).
GOOGLE_GENAI_USE_ENTERPRISE=0

# The model that drives the robot. It must take images and call tools.
ROBOT_AGENT_MODEL=gemini-4-hydrogen
